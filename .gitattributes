# How git should treat each kind of file.
#
# Without this, git prints a "LF will be replaced by CRLF" warning for every
# file on Windows. This settles it: text files are stored one consistent way,
# and binary files are left completely alone.

# Let git detect text files and store them with LF internally, while checking
# them out with Windows line endings so Notepad shows them correctly.
* text=auto

# PowerShell and friends are always text.
*.ps1   text
*.psd1  text
*.psm1  text
*.md    text
*.json  text
*.txt   text
*.py    text

# Never touch these - byte-for-byte as-is, or they corrupt.
*.pdf   binary
*.png   binary
*.jpg   binary
*.xlsx  binary
*.docx  binary
